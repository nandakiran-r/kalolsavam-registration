# Copy this file to .env.local and fill in the values before running locally.

# PostgreSQL connection string (Neon, Supabase, or any Postgres 14+ database).
# Neon/Supabase URLs normally end with ?sslmode=require
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Optional: unpooled connection string, used only for migrations if you prefer.
# DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Secret used to sign 8-hour admin session cookies.
# Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Optional: used by `npm run db:setup` to create the first admin, or by
# `npm run admin:reset` to create/reset a password. Remove after use.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="choose-a-strong-password"

# Optional: festival year (defaults to 2026) and roll-number validation pattern.
# NEXT_PUBLIC_YEAR=2026
# ROLL_NUMBER_PATTERN="^\\d{2}[A-Z]{2,5}\\d{1,4}$"
